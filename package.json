  "dependencies": { "lucide-react": "1.31.0", "react": "19.2.6", "react-dom": "19.2.6" },
  "devDependencies": { "@types/node": "22.19.19", "@types/react": "19.2.14", "@types/react-dom": "19.2.3", "@vitejs/plugin-react": "6.0.2", "esbuild": "0.28.0", "typescript": "5.9.3", "vite": "8.0.13" }
